# Environment Variables for PartyPilot
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Gemini API key (server-side only — never expose to the client)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model name (defaults to gemini-2.0-flash if not set)
GEMINI_MODEL=gemini-2.0-flash
